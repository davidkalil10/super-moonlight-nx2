#version 450
#extension GL_GOOGLE_include_directive : require
#include "ring.glsl"
layout(local_size_x=HBV2_LOCAL_SIZE) in;
#include "abi.glsl"
#include "hb.glsl"
layout(set=0,binding=1,std430) coherent buffer PrivateMemory { uint words[]; } memory;
#include "hbv2-tables.glsl"
#include "hbv2.glsl"
uint nativeChecksum(uint sequence,uint index,uint width,uint height,uint stride,uint rows,uint color){
 uint checksum=2166136261u;
 checksum=(checksum^sequence)*16777619u;
 checksum=(checksum^index)*16777619u;
 checksum=(checksum^width)*16777619u;
 checksum=(checksum^height)*16777619u;
 checksum=(checksum^stride)*16777619u;
 checksum=(checksum^rows)*16777619u;
 return (checksum^color)*16777619u;
}
void main(){
 if(gl_LocalInvocationIndex==0u){
  uint held=hbButtons();
  c.motion.x+=1.0/60.0;c.state.z++;
  c.transition.x=max(0.0,c.transition.x-1.0/15.0);
  if(hbConnected() && (held&(HB_PLUS|HB_MINUS))==(HB_PLUS|HB_MINUS))c.game.x++;else c.game.x=0u;
  if(c.game.x>=60u)hbExit();
  hbEndFrame();
 }
 if(gl_LocalInvocationIndex==0u){
  memory.words[CONTROL_NATIVE_READY]=NATIVE_ABI;
  uint sequence=memory.words[CONTROL_NATIVE_SEQUENCE];
  if(sequence!=0u){
   if(sequence!=memory.words[CONTROL_NATIVE_APPLIED]){
    uint index=memory.words[CONTROL_NATIVE_INDEX];
    uint width=memory.words[CONTROL_NATIVE_WIDTH],height=memory.words[CONTROL_NATIVE_HEIGHT];
    uint stride=memory.words[CONTROL_NATIVE_STRIDE],rows=memory.words[CONTROL_NATIVE_SLICE_HEIGHT];
    uint color=memory.words[CONTROL_NATIVE_COLOR];
    if(memory.words[CONTROL_NATIVE_COMMIT]==nativeChecksum(sequence,index,width,height,stride,rows,color)&&index<NATIVE_FRAMES&&width>=2u&&height>=2u&&width<=1920u&&height<=1088u&&stride>=width&&rows>=height&&stride*rows*3u/2u<=FRAME_BYTES){
     memory.words[CONTROL_CURRENT]=index;
     memory.words[CONTROL_SIZE]=width|(height<<16);
     memory.words[CONTROL_CURRENT_STRIDE]=stride;
     memory.words[CONTROL_CURRENT_SLICE_HEIGHT]=rows;
     memory.words[CONTROL_CURRENT_COLOR]=color;
     memory.words[CONTROL_MODE]=MODE_NATIVE;
     memoryBarrierBuffer();
     memory.words[CONTROL_NATIVE_APPLIED]=sequence;
    }
   }
  }else if(memory.words[CONTROL_MODE]==MODE_NATIVE){
   memory.words[CONTROL_MODE]=0u;
  }
 }
 memoryBarrierBuffer();
 barrier();
 if(memory.words[CONTROL_MODE]!=MODE_NATIVE)hbv2Step();
}
