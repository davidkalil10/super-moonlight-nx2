{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ],
    "skipLibCheck": true
  },
  "include": [
    "../hbl-moonlight/tools/moonlight/hbv.js",
    "../hbl-moonlight/tools/moonlight/hbv2.js",
    "../hbl-moonlight/tools/moonlight/hbv2-encoder.js",
    "../hbl-moonlight/tools/moonlight/encode-worker.js",
    "../hbl-moonlight/tools/moonlight/frames.js",
    "../hbl-moonlight/tools/moonlight/ring.js",
    "../hbl-moonlight/tools/moonlight/h264-stream.js",
    "../hbl-moonlight/tools/moonlight/reference.js"
  ]
}
