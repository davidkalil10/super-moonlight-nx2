{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "resolveJsonModule": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "skipLibCheck": true
  },
  "include": [
    "src/streamer/payload/*.js",
    "src/streamer/civ7/*.js",
    "src/streamer/shared/ring.js",
    "src/streamer/session/h264-stream.js",
    "src/streamer/session/h264-sps.js",
    "src/streamer/session/av1-stream.js",
    "src/streamer/session/bitrate.js",
    "src/streamer/input/controller.js",
    "src/streamer/session/protocol-binary.js",
    "src/streamer/input/touch.js",
    "src/streamer/input/input-record.js",
    "src/streamer/session/native-decoder.js",
    "src/streamer/ui/discover.js",
    "src/streamer/ui/hosts.js",
    "src/streamer/ui/model.js",
    "src/streamer/ui/page.js",
    "src/streamer/ui/pages.js",
    "src/streamer/ui/raster.js",
    "src/streamer/ui/service.js",
    "src/streamer/ui/settings.js"
  ]
}
